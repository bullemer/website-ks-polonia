---
export interface Props {
    id: string;
    title?: string;
    aspect?: '16:9' | '9:16' | 'short' | string;
}

const { id, title = 'YouTube Video', aspect = '16:9' } = Astro.props;
const isShort = aspect === '9:16' || aspect === 'short';
const embedUrl = `https://www.youtube-nocookie.com/embed/${id}`;
---

<div class:list={['youtube-embed', { 'youtube-embed-short': isShort }]}>
    <iframe 
        src={embedUrl}
        title={title}
        width="100%"
        height="100%"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
    ></iframe>
</div>

<style>
    .youtube-embed {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 */
        margin: 1.5rem 0;
        border-radius: var(--radius, 8px);
        overflow: hidden;
        box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08));
    }
    .youtube-embed.youtube-embed-short {
        max-width: 320px;
        padding-bottom: 0;
        aspect-ratio: 9 / 16;
        margin-left: auto;
        margin-right: auto;
    }
    .youtube-embed iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }
</style>
