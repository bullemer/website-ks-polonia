---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import WeatherWidget from '../components/WeatherWidget.astro';
import FAQ from '../components/FAQ.astro';
import YouTube from '../components/YouTube.astro';
import startpageData from '../content/startpage/index.json';
import heroImage from '../assets/images/fussball-finkenau.jpg';

const allNews = await getCollection('news');

// Sort news by date (newest first), fallback to title
const sortedNews = allNews.sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});

const latestNews = sortedNews.slice(0, 6);
---

<Layout 
    title="Polnischer Sportverein Hamburg – Fußball, Basketball & Badminton in Uhlenhorst" 
    description="KS Polonia Hamburg e.V. 1988 – Polnischer Sportverein (polski klub sportowy) in Hamburg-Uhlenhorst. Fußball, Basketball und Badminton für Kinder, Jugendliche und Erwachsene. Probetraining jederzeit möglich!"
    type="website"
>
    <!-- Hero Section with Background Image -->
    <section class="hero" id="hero">
        <Image 
            src={heroImage} 
            alt="Fußballplatz an der Finkenau – KS Polonia Hamburg" 
            class="hero-bg"
            width={1400}
            height={600}
            loading="eager"
        />
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1>{startpageData.heroTitle}</h1>
            <p class="hero-subtitle">{startpageData.heroSubtitle}</p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">1988</span>
                    <span class="hero-stat-label">Gegründet</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">3</span>
                    <span class="hero-stat-label">Sportarten</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">15+</span>
                    <span class="hero-stat-label">Mannschaften</span>
                </div>
            </div>
            <a href="/seiten/probetraining" class="hero-cta" id="hero-cta">
                Kostenloses Probetraining anfragen
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>
    </section>

    <!-- Latest News -->
    <section class="section" id="news">
        <div class="section-header">
            <h2>Aktuelle Nachrichten</h2>
            <a href="/news" class="view-all">Alle anzeigen →</a>
        </div>
        <div class="news-grid">
            {latestNews.map((post) => {
                const imgData = post.data.coverImage && typeof post.data.coverImage === 'object' && post.data.coverImage.src
                    ? post.data.coverImage : null;
                return (
                    <a href={`/news/${post.id}`} class="news-card">
                        <div class="news-card-image">
                            {imgData ? (
                                <Image src={imgData} alt={post.data.title || ''} width={400} height={267} />
                            ) : (
                                <div class="news-image-placeholder">
                                    <svg viewBox="0 0 24 24" width="40" height="40" stroke="currentColor" stroke-width="1.5" fill="none">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                </div>
                            )}
                        </div>
                        <div class="news-card-body">
                            <h3>{post.data.title}</h3>
                            {post.data.date && (
                                <time class="news-date">
                                    {new Date(post.data.date).toLocaleDateString('de-DE', {
                                        day: '2-digit', month: 'long', year: 'numeric'
                                    })}
                                </time>
                            )}
                            {post.data.category && (
                                <span class="news-category">{post.data.category}</span>
                            )}
                        </div>
                    </a>
                );
            })}
        </div>
    </section>

    <!-- Active City Day 2026 Video -->
    <section class="section" id="video">
        <div class="section-header">
            <h2>Active City Day 2026 – KS Polonia macht mit! 🎬</h2>
        </div>
        <div class="video-highlight">
            <div class="video-highlight-embed">
                <YouTube id="qX-0HmuucTI" title="Active City Day 2026 – KS Polonia Hamburg" />
            </div>
            <div class="video-highlight-text">
                <h3>Fußball, Basketball & polnische Spezialitäten an der Finkenau</h3>
                <p>Am Active City Day 2026 war der KS Polonia mit einem bunten Programm dabei: Basketball für Kids und Ü35, Mini-Fußball für die Jugend und polnische Spezialitäten – direkt an der Finkenau in Hamburg Uhlenhorst.</p>
                <a href="/news/active-city-day-2026-ks-polonia-macht-mit" class="video-highlight-cta">Zum Artikel →</a>
            </div>
        </div>
    </section>

    <!-- Weather & Pitch Status — Compact Inline Bar -->
    <section class="section" id="weather-status">
        <WeatherWidget />
    </section>

    <!-- Next Matches — Full-Width, Height-Capped -->
    <section class="section" id="matches">
        <div class="section-header">
            <h2>Nächste Spiele</h2>
            <a href="/spieltermine" class="view-all">Alle Termine →</a>
        </div>
        <div class="matches-container" id="matches-container">
            <script is:inline type="text/javascript" src="https://www.fussball.de/widgets.js"></script>
            <div 
              class="fussballde_widget"
              data-id="576e80b1-c9b0-4ea0-a1ca-b7bcf6a4b9b7"
              data-type="club-matches"
              style="width: 100%"
            ></div>
            <div class="matches-fade"></div>
        </div>
        <div class="matches-show-more">
            <button class="matches-toggle-btn" id="matchesToggle" type="button">
                Mehr Spiele anzeigen
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </div>
    </section>

    <!-- Unsere Sportarten – 2×2 Grid -->
    <section class="section" id="sportarten">
        <div class="section-header">
            <h2>Unsere Sportarten in Uhlenhorst &amp; Barmbek</h2>
        </div>
        <div class="sports-grid">
            <a href="/seiten/basketball-jugend-u12" class="sport-card sport-card--basketball">
                <span class="sport-icon">🏀</span>
                <h3>Kinder Basketball Hamburg U12</h3>
                <p>Kinder Basketball in Hamburg Uhlenhorst & Barmbek – Dienstags 17:00 Uhr in der Sporthalle. Kostenloses Probetraining jederzeit!</p>
                <span class="sport-cta">Mehr erfahren →</span>
            </a>
            <a href="/seiten/basketball-herren-ue35" class="sport-card sport-card--basketball">
                <span class="sport-icon">🏀</span>
                <h3>Basketball Herren Ü35</h3>
                <p>Freizeit-Basketball in Hamburg für Erwachsene – Dienstags 18:30 Uhr in Uhlenhorst/Barmbek.</p>
                <span class="sport-cta">Mehr erfahren →</span>
            </a>
            <a href="/seiten/aktuelles" class="sport-card sport-card--fussball">
                <span class="sport-icon">⚽</span>
                <h3>Fußball</h3>
                <p>Herren, Jugend &amp; Kinder – Spielbetrieb in der Kreisliga und im Pokal. Trainingsplatz an der Finkenau.</p>
                <span class="sport-cta">Mehr erfahren →</span>
            </a>
            <a href="/seiten/badminton" class="sport-card sport-card--badminton">
                <span class="sport-icon">🏸</span>
                <h3>Badminton</h3>
                <p>Badminton für Erwachsene in Hamburg – Regelmäßiges Training und Turniere.</p>
                <span class="sport-cta">Mehr erfahren →</span>
            </a>
        </div>
    </section>

    <!-- Mitmachen CTA Banner -->
    <section class="section" id="mitmachen">
        <div class="cta-banner">
            <div class="cta-banner-content">
                <h2>Werde Teil der Polonia-Familie! 🇵🇱</h2>
                <p>Egal ob Fußball, Basketball oder Badminton – bei KS Polonia ist jeder willkommen. Komm einfach zum kostenlosen Probetraining vorbei!</p>
                <div class="dauerkarte-highlight">
                    <span class="dauerkarte-badge">🎟️ Saisondauerkarte – nur 40 €</span>
                    <span class="dauerkarte-text">Freier Eintritt zu allen Heimspielen der Saison!</span>
                </div>
                <div class="cta-banner-buttons">
                    <a href="/seiten/probetraining" class="cta-btn cta-btn--primary" id="cta-probetraining">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Probetraining anfragen
                    </a>
                    <a href="/dauerkarte" class="cta-btn cta-btn--primary" id="cta-dauerkarte">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="7" width="20" height="10" rx="2"/><line x1="7" y1="7" x2="7" y2="17"/><line x1="17" y1="7" x2="17" y2="17"/></svg>
                        Dauerkarte sichern
                    </a>
                    <a href="/mitgliedsantrag" class="cta-btn cta-btn--secondary" id="cta-mitglied">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                        Mitglied werden
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Häufig gestellte Fragen (FAQ) -->
    <section class="section" id="faq">
        <FAQ items={[
            {
                question: "Muss man Polnisch sprechen, um bei KS Polonia zu spielen?",
                answer: "Nein, absolut nicht! Obwohl wir 1988 als polnischer Sportverein gegründet wurden, sind bei uns alle Nationalitäten und Sprachen herzlich willkommen. Heute spielen bei uns Sportler aus Deutschland, Polen, der Ukraine, der Türkei und vielen weiteren Nationen. Unser Motto: Integration durch Sport."
            },
            {
                question: "Gibt es Kinder Basketball in Hamburg bei euch?",
                answer: "Ja! Seit der Saison 2025/2026 bieten wir Kinder Basketball in Hamburg-Uhlenhorst und Barmbek an. Unsere U12-Mannschaft trainiert jeden Dienstag von 17:00 bis 18:30 Uhr in der Sporthalle am Sportplatz Finkenau (Finkenau 38). Kinder sind herzlich willkommen – ein kostenloses Probetraining ist jederzeit möglich!"
            },
            {
                question: "Ab welchem Alter können Kinder bei euch Fußball oder Basketball spielen?",
                answer: "Beim Fußball nehmen wir Kinder ab der F-Jugend (ca. 6 Jahre) auf. Beim Kinder Basketball Hamburg starten wir mit der U12. Für beide Sportarten gilt: Einfach zum kostenlosen Probetraining vorbeikommen!"
            },
            {
                question: "Welche Sportarten bietet der Verein in Hamburg an?",
                answer: "Wir bieten ein breites Sportangebot mit Fokus auf Hamburg-Uhlenhorst und Barmbek: Fußball (für alle Altersklassen von Jugend bis Senioren Ü40/Ü50), Kinder Basketball Hamburg U12, Basketball Herren Ü35 sowie Badminton."
            },
            {
                question: "Wo findet das Training statt?",
                answer: "Unser Fußballplatz, die Sporthalle und das Vereinsheim liegen an der Finkenau 38 in Hamburg-Uhlenhorst (U-Bahn Mundsburg). Alle Trainings finden zentral an unserem Vereinsgelände an der Finkenau statt – nur wenige Gehminuten von der U3 Mundsburg entfernt."
            },
            {
                question: "Wie kann man sich für ein Probetraining anmelden?",
                answer: "Ein kostenloses Probetraining ist bei allen unseren Mannschaften jederzeit möglich! Füllt einfach das Formular unter 'Verein > Probetraining anfragen' aus, gebt an, ob ihr oder eure Kinder Fußball, Basketball oder Badminton spielen möchtet, und wir melden uns mit dem perfekten Zeitfenster."
            }
        ]} />
    </section>

    <!-- So findest du uns – Google Maps + Contact Info -->
    <section class="section" id="anfahrt">
        <div class="section-header">
            <h2>So findest du uns</h2>
        </div>
        <div class="location-grid">
            <div class="location-map">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2369.5!2d10.026131!3d53.568461!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47b18f1b5e8a4c27%3A0x4a3c8d6e8b4b4a0a!2sFinkenau%2038%2C%2022081%20Hamburg!5e0!3m2!1sde!2sde!4v1234567890"
                    width="100%"
                    height="100%"
                    style="border:0; border-radius: var(--radius);"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="KS Polonia Hamburg – Sportplatz Finkenau 38"
                ></iframe>
            </div>
            <div class="location-info">
                <div class="location-detail">
                    <div class="location-icon">📍</div>
                    <div>
                        <strong>Sportplatz Finkenau</strong>
                        <p>Finkenau 38, 22081 Hamburg</p>
                    </div>
                </div>
                <div class="location-detail">
                    <div class="location-icon">🚇</div>
                    <div>
                        <strong>U-Bahn Mundsburg (U3)</strong>
                        <p>5 Minuten Fußweg</p>
                    </div>
                </div>
                <div class="location-detail">
                    <div class="location-icon">⚽</div>
                    <div>
                        <strong>Training & Spieltage</strong>
                        <p>Mo–So nach Spielplan</p>
                        <a href="/trainingszeiten" class="location-link">Trainingszeiten ansehen →</a>
                    </div>
                </div>
                <div class="location-detail">
                    <div class="location-icon">✉️</div>
                    <div>
                        <strong>Kontakt</strong>
                        <p>info@ks-polonia.de</p>
                        <a href="/kontakt" class="location-link">Kontaktformular →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Berlinale 2024 Video -->
    <section class="section" id="berlinale">
        <div class="section-header">
            <h2>Berlinale 2024 - Berlinale meets Fußball 🎬</h2>
            <a href="/news/berlinale-meets-fussball-filmprojekt-zur-euro2024" class="view-all">Mehr erfahren →</a>
        </div>
        <div class="berlinale-highlight">
            <div class="berlinale-video-embed">
                <YouTube id="Mp8J2oMbr5U" title="Berlinale 2024 - Berlinale meets Fußball" />
            </div>
            <div class="berlinale-video-text">
                <h3>Kompilationsfilm „Elf Mal Morgen“ mit der Jugend von KS Polonia</h3>
                <p>Im Rahmen des Kulturprogramms zur Fußball-Europameisterschaft 2024 begleitete die Berlinale mit Studierenden der HFF München junge Fußballerinnen und Fußballer aus ganz Deutschland. Der K.S. Polonia Hamburg war stolzer Teil dieses einzigartigen Projekts, das bei den Internationalen Filmfestspielen Berlin Premiere feierte.</p>
                <div class="berlinale-actions">
                    <a href="/news/berlinale-meets-fussball-filmprojekt-zur-euro2024" class="video-highlight-cta">Zum Projektbericht →</a>
                    <a href="https://youtu.be/Mp8J2oMbr5U?si=qUneRmu1hfGZcnLR" target="_blank" rel="noopener noreferrer" class="video-highlight-cta" style="color: var(--color-text-muted);">Auf YouTube ansehen ↗</a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* ═══════════════════════════════════════
       HERO
       ═══════════════════════════════════════ */
    .hero {
        position: relative;
        border-radius: var(--radius);
        margin-bottom: 3rem;
        overflow: hidden;
        min-height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg, 
            rgba(139, 0, 0, 0.85) 0%, 
            rgba(220, 20, 60, 0.7) 40%, 
            rgba(26, 26, 46, 0.8) 100%
        );
        z-index: 1;
    }
    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: white;
        padding: 4rem 2rem;
        max-width: 800px;
    }
    .hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }
    .hero-subtitle {
        font-size: 1.15rem;
        opacity: 0.92;
        font-weight: 400;
        margin-bottom: 2rem;
    }

    /* Stats Badges */
    .hero-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }
    .hero-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
    }
    .hero-stat-number {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
    }
    .hero-stat-label {
        font-size: 0.78rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.8;
    }
    .hero-stat-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.3);
    }

    /* CTA Button */
    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: white;
        color: var(--color-primary);
        font-size: 1rem;
        font-weight: 700;
        padding: 0.85rem 1.75rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .hero-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 28px rgba(0,0,0,0.3);
        color: var(--color-primary-dark);
    }

    /* ═══════════════════════════════════════
       SECTIONS
       ═══════════════════════════════════════ */
    .section {
        margin-bottom: 3rem;
    }
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--color-border);
        padding-bottom: 0.75rem;
    }
    .section-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
    }
    .view-all {
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* ═══════════════════════════════════════
       NEWS GRID
       ═══════════════════════════════════════ */
    .news-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.25rem;
    }
    .news-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }
    .news-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-4px);
        color: inherit;
    }
    .news-card-image {
        aspect-ratio: 3/2;
        overflow: hidden;
        background: #f1f5f9;
    }
    .news-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .news-card:hover .news-card-image img {
        transform: scale(1.05);
    }
    .news-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        color: #94a3b8;
    }
    .news-card-body {
        padding: 1.25rem;
    }
    .news-card h3 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .news-date {
        font-size: 0.8rem;
        color: var(--color-text-muted);
        display: block;
        margin-bottom: 0.25rem;
    }
    .news-category {
        font-size: 0.7rem;
        background: rgba(220,20,60,0.08);
        color: var(--color-primary);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* ═══════════════════════════════════════
       VIDEO HIGHLIGHT
       ═══════════════════════════════════════ */
    .video-highlight {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 2rem;
        align-items: center;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
    }
    .video-highlight-embed {
        width: 280px;
        aspect-ratio: 9/16;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        flex-shrink: 0;
    }
    .video-highlight-embed :global(.youtube-embed) {
        padding-bottom: 177.78%; /* 9:16 for Shorts */
        margin: 0;
        border-radius: 0;
        box-shadow: none;
    }
    .video-highlight-text {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .video-highlight-text h3 {
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.3;
    }
    .video-highlight-text p {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }
    .video-highlight-cta {
        display: inline-block;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-primary);
        margin-top: 0.25rem;
    }
    .video-highlight-cta:hover {
        text-decoration: underline;
    }

    /* ═══════════════════════════════════════
       BERLINALE 2024 VIDEO HIGHLIGHT
       ═══════════════════════════════════════ */
    .berlinale-highlight {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 2rem;
