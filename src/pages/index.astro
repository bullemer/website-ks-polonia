<script>
    // Toggle matches expand/collapse
    const toggleBtn = document.getElementById('matchesToggle');
    const matchesContainer = document.getElementById('matches-container');

    toggleBtn?.addEventListener('click', () => {
        const isExpanded = matchesContainer?.classList.toggle('expanded');
        toggleBtn.classList.toggle('expanded');
        toggleBtn.innerHTML = isExpanded 
            ? 'Weniger Spiele <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"/></svg>'
            : 'Mehr Spiele anzeigen <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"/></svg>';
    });
</script>
