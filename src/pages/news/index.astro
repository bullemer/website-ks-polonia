---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allNews = await getCollection('news');

const sortedNews = allNews.sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});

// Prepare serializable data for client-side merging
const staticArticles = sortedNews.map(post => {
    const imgData = post.data.coverImage && typeof post.data.coverImage === 'object' && post.data.coverImage.src
        ? post.data.coverImage : null;
    return {
        id: `static-${post.id}`,
        title: post.data.title,
        slug: post.id,
        url: `/news/${post.id}`,
        summary: post.data.summary || '',
        category: post.data.category || 'Allgemein',
        coverImage: imgData ? imgData.src : null,
        date: post.data.date ? new Date(post.data.date).toISOString() : null,
        source: 'static' as const,
    };
});

const ITEMS_PER_PAGE = 12;
const totalPages = Math.ceil(staticArticles.length / ITEMS_PER_PAGE);

// JSON-LD for news listing
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Nachrichten – KS Polonia Hamburg",
    "description": "Aktuelle Neuigkeiten, Spielberichte, Vereinsmeldungen und Berichte rund um KS Polonia Hamburg e.V. 1988",
    "url": "https://www.ks-polonia.de/news",
    "isPartOf": {
        "@type": "WebSite",
        "name": "KS Polonia Hamburg",
        "url": "https://www.ks-polonia.de"
    }
};
---

<Layout 
    title="Nachrichten & Berichte | KS Polonia Hamburg" 
    description="Aktuelle Neuigkeiten, Spielberichte, Vereinsmeldungen und Berichte rund um den polnischen Sportverein KS Polonia Hamburg e.V. 1988 in Uhlenhorst."
>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <div class="news-page">
        <!-- Header -->
        <div class="news-header">
            <h1>📰 Nachrichten & Berichte</h1>
            <p class="news-header-desc">Aktuelle Neuigkeiten, Spielberichte und Vereinsmeldungen vom KS Polonia Hamburg</p>
        </div>

        <!-- Category Filter -->
        <div class="news-filters" id="newsFilters">
            <button class="filter-btn active" data-category="all">Alle</button>
            <button class="filter-btn" data-category="Allgemein">Allgemein</button>
            <button class="filter-btn" data-category="Kinder">Kinder</button>
            <button class="filter-btn" data-category="Spielbericht">Spielbericht</button>
            <button class="filter-btn" data-category="Vereinsleben">Vereinsleben</button>
        </div>

        <!-- News Grid -->
        <div class="news-grid" id="newsGrid">
            {staticArticles.slice(0, ITEMS_PER_PAGE).map((post) => (
                <a href={post.url} class="news-card" data-category={post.category}>
                    <div class="news-card-image">
                        {post.coverImage ? (
                            <img src={post.coverImage} alt={post.title} loading="lazy" />
                        ) : (
                            <div class="news-image-placeholder">
                                <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" stroke-width="1.5" fill="none">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                            </div>
                        )}
                    </div>
                    <div class="news-card-body">
                        <div class="news-card-meta">
                            {post.category && <span class="news-category">{post.category}</span>}
                            {post.date && (
                                <time datetime={post.date}>
                                    {new Date(post.date).toLocaleDateString('de-DE', {
                                        day: '2-digit', month: 'long', year: 'numeric'
                                    })}
                                </time>
                            )}
                        </div>
                        <h2 class="news-card-title">{post.title}</h2>
                        {post.summary && <p class="news-card-summary">{post.summary.slice(0, 150)}{post.summary.length > 150 ? '…' : ''}</p>}
                        <span class="news-card-link">Weiterlesen →</span>
                    </div>
                </a>
            ))}
        </div>

        <!-- Pagination -->
        <div class="news-pagination" id="newsPagination">
            <button class="pagination-btn" id="prevPageBtn" disabled>← Zurück</button>
            <span class="pagination-info" id="paginationInfo">Seite 1 von {totalPages}</span>
            <button class="pagination-btn" id="nextPageBtn">Weiter →</button>
        </div>
    </div>

    <!-- Pass static data to client script -->
    <script define:vars={{ staticArticlesJSON: JSON.stringify(staticArticles), itemsPerPage: ITEMS_PER_PAGE }}>
        window.__staticArticles = JSON.parse(staticArticlesJSON);
        window.__itemsPerPage = itemsPerPage;
    </script>
</Layout>

<style>
    .news-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .news-header {
        margin-bottom: 2rem;
        text-align: center;
    }
    .news-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
    }
    .news-header-desc {
        font-size: 1.05rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    /* Filters */
    .news-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        justify-content: center;
    }
    .filter-btn {
        padding: 0.5rem 1.2rem;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        font-family: inherit;
    }
    .filter-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .filter-btn.active { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }

    /* News Grid */
    .news-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .news-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.2s, transform 0.15s;
        display: flex;
        flex-direction: column;
    }
    .news-card:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        transform: translateY(-3px);
        color: inherit;
    }

    .news-card-image {
        height: 200px;
        overflow: hidden;
        background: var(--color-border);
    }
    .news-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s;
    }
    .news-card:hover .news-card-image img {
        transform: scale(1.05);
    }
    .news-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        opacity: 0.4;
    }

    .news-card-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .news-card-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
        font-size: 0.78rem;
        color: var(--color-text-muted);
    }
    .news-category {
        background: rgba(220,20,60,0.08);
        color: var(--color-primary);
        padding: 0.15rem 0.6rem;
        border-radius: 4px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 0.7rem;
    }

    .news-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 0.5rem;
    }

    .news-card-summary {
        font-size: 0.88rem;
        color: var(--color-text-muted);
        line-height: 1.55;
        flex: 1;
        margin-bottom: 0.75rem;
    }

    .news-card-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-primary);
        margin-top: auto;
    }

    /* Pagination */
    .news-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 2rem 0;
    }
    .pagination-btn {
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        font-family: inherit;
    }
    .pagination-btn:hover:not(:disabled) { border-color: var(--color-primary); color: var(--color-primary); }
    .pagination-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    .pagination-info { font-size: 0.85rem; color: var(--color-text-muted); font-weight: 500; }

    @media (max-width: 768px) {
        .news-header h1 { font-size: 1.6rem; }
        .news-grid { grid-template-columns: 1fr; }
        .news-card-image { height: 180px; }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    const staticArticles = (window as any).__staticArticles || [];
    const itemsPerPage = (window as any).__itemsPerPage || 12;
    const grid = document.getElementById('newsGrid')!;
    const pagination = document.getElementById('newsPagination')!;
    const prevBtn = document.getElementById('prevPageBtn') as HTMLButtonElement;
    const nextBtn = document.getElementById('nextPageBtn') as HTMLButtonElement;
    const pageInfo = document.getElementById('paginationInfo')!;

    // Fetch DB news and merge
    let dbArticles: any[] = [];
    try {
        const resp = await fetch('/api/news/api/articles?limit=100');
        const data = await resp.json();
        if (data.articles) {
            dbArticles = data.articles.map((a: any) => ({
                id: `db-${a.id}`,
                title: a.title,
                slug: a.slug,
                url: `/api/news/article/${a.slug}`,
                summary: a.summary || '',
                category: a.category || 'Allgemein',
                coverImage: a.cover_image,
                date: a.published_at,
                source: 'db',
                authorName: a.author_name,
            }));
        }
    } catch {}

    // Merge and sort by date desc
    let allArticles = [...staticArticles, ...dbArticles].sort((a: any, b: any) => {
        const da = a.date ? new Date(a.date).getTime() : 0;
        const db = b.date ? new Date(b.date).getTime() : 0;
        return db - da;
    });

    let filteredArticles = allArticles;
    let currentPage = 1;
    let activeCategory = 'all';

    function renderPage() {
        const totalPages = Math.max(1, Math.ceil(filteredArticles.length / itemsPerPage));
        currentPage = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * itemsPerPage;
        const pageArticles = filteredArticles.slice(start, start + itemsPerPage);

        grid.innerHTML = pageArticles.map((post: any) => {
            const dateStr = post.date ? new Date(post.date).toLocaleDateString('de-DE', {
                day: '2-digit', month: 'long', year: 'numeric'
            }) : '';
            const dateISO = post.date ? new Date(post.date).toISOString() : '';
            const url = post.source === 'db' ? `/news/portal-${post.slug}` : post.url;

            return `
                <a href="${url}" class="news-card" data-category="${post.category}">
                    <div class="news-card-image">
                        ${post.coverImage
                            ? `<img src="${post.coverImage}" alt="${post.title}" loading="lazy" />`
                            : `<div class="news-image-placeholder">
                                <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" stroke-width="1.5" fill="none">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                            </div>`}
                    </div>
                    <div class="news-card-body">
                        <div class="news-card-meta">
                            ${post.category ? `<span class="news-category">${post.category}</span>` : ''}
                            ${dateStr ? `<time datetime="${dateISO}">${dateStr}</time>` : ''}
                        </div>
                        <h2 class="news-card-title">${post.title}</h2>
                        ${post.summary ? `<p class="news-card-summary">${post.summary.slice(0, 150)}${post.summary.length > 150 ? '…' : ''}</p>` : ''}
                        <span class="news-card-link">Weiterlesen →</span>
                    </div>
                </a>
            `;
        }).join('');

        // Pagination
        pageInfo.textContent = `Seite ${currentPage} von ${totalPages}`;
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;
        pagination.style.display = totalPages <= 1 ? 'none' : 'flex';
    }

    // Filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeCategory = btn.getAttribute('data-category') || 'all';
            if (activeCategory === 'all') {
                filteredArticles = allArticles;
            } else {
                filteredArticles = allArticles.filter((a: any) => a.category === activeCategory);
            }
            currentPage = 1;
            renderPage();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    });

    // Pagination
    prevBtn.addEventListener('click', () => { currentPage--; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    nextBtn.addEventListener('click', () => { currentPage++; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); });

    // Re-render with merged data
    renderPage();
});
</script>
